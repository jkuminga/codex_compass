{
  "description": "Prepare WorkItem context, protect project changes, and maintain Runtime Bindings across Codex Turns.",
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/bin/harness-user-prompt-submit\"",
            "timeout": 300,
            "statusMessage": "Preparing project work context",
            "additionalContextLimit": 1800
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/bin/harness-pre-tool-use\"",
            "timeout": 10,
            "statusMessage": "Checking project work authorization"
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/bin/harness-post-tool-use\"",
            "timeout": 20,
            "statusMessage": "Recording completed tool events",
            "additionalContextLimit": 1000
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$(git rev-parse --show-toplevel)/bin/harness-stop\"",
            "timeout": 10,
            "statusMessage": "Checking project work closeout"
          }
        ]
      }
    ]
  }
}
