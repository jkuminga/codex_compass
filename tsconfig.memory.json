{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "strict": true,
    "noEmit": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "types": ["bun"],
    "typeRoots": ["./vendor/memory-graph/ts/node_modules/@types"]
  },
  "include": [
    "src/harness/memory/**/*.ts",
    "tests/memory/**/*.ts"
  ]
}
